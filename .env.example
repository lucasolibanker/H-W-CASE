# Copie para .env. Estes valores são só do laboratório do case.
# Qualquer ambiente compartilhado precisa de segredo novo, gerado fora do git.
# O .env em si não entra no repositório (.gitignore).

# Segredo do HMAC do webhook. O mock do PSP e a API precisam do mesmo valor.
PSP_HMAC_SECRET=dev-only-psp-hmac-secret

# Pepper do fingerprint do PAN. Não é o segredo do webhook, de propósito:
# vazar um não entrega o outro.
PAN_PEPPER=dev-only-pan-pepper

# URLs quando a API roda na máquina. O docker-compose sobrescreve
# REDIS_URL, DATABASE_URL e PSP_BASE_URL com os nomes da rede interna.
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://antifraud:antifraud@localhost:5433/antifraud
PSP_BASE_URL=http://localhost:8001

# O mock usa isto quando roda fora do compose. No compose, apontamos para http://api:8000.
WEBHOOK_URL=http://localhost:8000/webhooks/psp

RULES_PATH=config/rules.yml
BINS_PATH=config/bins.csv
IP_COUNTRIES_PATH=config/ip_countries.csv
DISPOSABLE_EMAILS_PATH=config/disposable_domains.txt

# true desliga os controles. false deixa todos ligados.
# Os scripts da Parte 4 também desligam um controle por request
# com o header X-Naive-Controls, mas só se ALLOW_DEMO_HEADER=true.
# Os dois precisam estar false fora deste laboratório: senão o atacante
# desliga o antifraude mandando um header.
NAIVE_MODE=false
ALLOW_DEMO_HEADER=true

# Devolve o OTP no JSON do challenge para demonstrar o step-up.
# Em produção o OTP sai por outro canal e este campo não existe.
EXPOSE_OTP=true

IDEMPOTENCY_TTL_SECONDS=86400
WEBHOOK_TOLERANCE_SECONDS=300
REPLAY_TTL_SECONDS=86400
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
# Espera, em milissegundos, quando a idempotência está desligada. Só vale nesse caso.
NAIVE_RACE_WINDOW_MS=250

# Alto de propósito para os scripts de ataque caberem numa janela.
# O controle existe e está testado; o número de produção seria bem menor.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60

LAB_LOCAL_COUNTRY=BR
